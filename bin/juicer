#!/usr/bin/env python3
"""Juicer Kit v2.3 CLI. Dependency-free project workflow controller."""

from __future__ import annotations
import argparse, contextlib, getpass, hashlib, importlib.util, json, os, re, shutil, subprocess, sys, uuid
from datetime import datetime, timezone
from pathlib import Path

try:
    import fcntl
except ImportError:  # non-POSIX: the advisory lock degrades to a no-op
    fcntl = None

ROOT = Path.cwd()
KIT = Path(__file__).resolve().parents[1]
STATE = ROOT / ".juicer" / "state.json"
MISSION = ROOT / ".juicer" / "mission.md"
PLAN = ROOT / ".juicer" / "plan.md"
HANDOFF = ROOT / ".juicer" / "handoff.md"
# Pristine sources shipped to new projects. The kit's own
# .juicer/mission.md and .juicer/plan.md are this repository's live
# workflow state and must never be used as templates.
MISSION_TEMPLATE = KIT / ".juicer" / "templates" / "mission.md"
PLAN_TEMPLATE = KIT / ".juicer" / "templates" / "plan.md"

WORKER_NAME = re.compile(r"^[a-z][a-z0-9-]*$")
MISSION_MARKER = "## Success criteria"
PROJECT_MIRRORS = (
    ".opencode/agents/", ".opencode/juicer-kit.md",
    ".claude/agents/", ".claude/skills/", ".claude/juicer-kit.md",
    ".cursor/agents/", ".cursor/juicer-kit.md",
    ".codex/agents/", ".codex/juicer-kit.md",
    ".juicer/runtime/", ".juicer/state.lock", ".juicer/state.json.tmp",
)
GITIGNORE_MARKER = "# Juicer Kit — generated mirrors"

sys.path.insert(0, str(KIT / "adapters"))
from _base import (Ctx, confine_generated, confine_manifest_entry,  # noqa: E402
                   confine_path, ownership_scope, require_owned, sha256_file)

def fail(message):
    print(f"error: {message}", file=sys.stderr)
    sys.exit(1)

def now():
    return datetime.now(timezone.utc).isoformat()

# --- Write confinement (B-01) ----------------------------------------------
# confine_path() is the single choke point for every file Juicer writes.
# Adapters get it through write_generated(); the CLI itself must apply it
# to its OWN writes (state, mission, lock, manifest, .gitignore, init
# copies), otherwise a symlink planted inside the repository redirects a
# legitimate write outside the project root.

def confine_write(path, what="path"):
    """Require ``path`` to resolve strictly inside ROOT before any write.

    Exits with a clean error (never a traceback) when a symlink or ``..``
    sends the target outside the workspace.
    """
    try:
        return confine_path(ROOT, path, what=what)
    except ValueError as error:
        fail(str(error))

def _trusted_text(path, what):
    """Read a workspace file only if it resolves inside ROOT or the KIT.

    A planted symlink must not turn a plain read (status output, worker
    contract) into an arbitrary-file disclosure.
    """
    resolved = Path(path).resolve()
    for base in (ROOT, KIT):
        try:
            resolved.relative_to(Path(base).resolve())
            return Path(path).read_text()
        except ValueError:
            continue
    fail(f"{what} {path} resolves outside the project and the kit ({resolved})")

# --- State persistence (BUG-01) -------------------------------------------
# Every write goes through an exclusive advisory lock and an atomic
# replace with monotonic revision fencing: stale writers fail instead of
# silently resurrecting lost state.

_lock_depth = 0
_lock_warned = False

@contextlib.contextmanager
def state_lock():
    """Exclusive advisory lock over the workspace state (reentrant)."""
    global _lock_depth, _lock_warned
    if fcntl is None and not _lock_warned:
        _lock_warned = True
        print("warning: this platform has no fcntl; state locking is not "
              "enforced, only the revision fence applies (docs/security.md §8)",
              file=sys.stderr)
    if fcntl is None or _lock_depth:
        _lock_depth += 1
        try:
            yield
        finally:
            _lock_depth -= 1
        return
    path = ROOT / ".juicer" / "state.lock"
    confine_write(path, what="state lock")
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        _lock_depth += 1
        try:
            yield
        finally:
            _lock_depth -= 1
    finally:
        os.close(fd)

def _read_disk_state():
    if not STATE.exists():
        return None
    try:
        return json.loads(STATE.read_text())
    except ValueError as error:
        fail(f"Invalid state file {STATE}: {error}")

def read_state():
    disk = _read_disk_state()
    if disk is None:
        return {"schema":1,"kit_version":"2.4.0","status":"uninitialized"}
    return disk

def _state_revision(state):
    value = (state or {}).get("revision", 0)
    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
        fail(f"Invalid state file {STATE}: revision must be a non-negative integer")
    return value

def _atomic_write_text(path, text):
    """Replace ``path`` atomically (tmp + fsync + rename) next to itself."""
    confine_write(path, what="write target")
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.parent / (path.name + ".tmp")
    try:
        with open(tmp, "w", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, path)
        dir_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(dir_fd)
        finally:
            os.close(dir_fd)
    finally:
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass

def _fenced_write(state):
    """Persist state.json; reject stale writers via the revision fence."""
    disk = _read_disk_state()
    disk_rev = _state_revision(disk)
    passed = _state_revision(state)
    if passed != disk_rev:
        fail(f"stale state revision: expected {disk_rev}, got {passed} "
             "(state changed on disk since it was read; re-read and retry)")
    state["revision"] = disk_rev + 1
    state["updated_at"] = now()
    _atomic_write_text(STATE, json.dumps(state, indent=2) + "\n")

def write_state(state):
    """Direct fenced write. Prefer update_state() for read-modify-write flows."""
    with state_lock():
        _fenced_write(state)

def update_state(mutator):
    """Read-modify-write under one exclusive lock.

    The gate/mutation runs on a fresh disk copy; ship approvals are
    eagerly re-validated before the write so the persisted JSON is always
    consistent for direct readers.
    """
    with state_lock():
        state = _read_disk_state()
        if state is None:
            state = {"schema":1,"kit_version":"2.4.0","status":"idle","mission_id":None,
                     "current_unit":None,"approved":False,"ship_approved":False}
        mutator(state)
        if state.get("ship_approved"):
            _refresh_ship_approval(state)
        _fenced_write(state)
        return state

def ensure_mission():
    mission = ROOT / ".juicer" / "mission.md"
    confine_write(mission, what="mission file")
    if not mission.exists():
        mission.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(MISSION_TEMPLATE, mission)

def ensure_runtime():
    confine_write(ROOT / ".juicer" / "state.json", what="state file")
    (ROOT / ".juicer").mkdir(exist_ok=True)
    if not STATE.exists():
        update_state(lambda state: None)
    ensure_mission()

# --- Approval provenance (BUG-02) -----------------------------------------

def approval_identity(by):
    """Resolve who is approving: explicit automation id, or the interactive OS user."""
    if by is not None:
        by = by.strip()
        if not by:
            fail("--by requires a non-empty identifier")
        return by, "automation"
    if sys.stdin.isatty():
        try:
            user = getpass.getuser()
        except OSError:
            user = ""
        return (user or "unknown"), "interactive"
    fail("cannot record approval without an identity: stdin is not a TTY; "
         "pass --by=<id> for automation (e.g. --by=ci)")

def _new_record(state, **fields):
    """Provenance record stamped with the revision this write will produce."""
    fields.setdefault("revision", _state_revision(state) + 1)
    fields.setdefault("at", now())
    return fields

def _record_valid(record, require_target=False):
    if not isinstance(record, dict):
        return False
    if not isinstance(record.get("by"), str) or not record["by"].strip():
        return False
    if not isinstance(record.get("at"), str) or not record["at"].strip():
        return False
    if record.get("via") not in ("interactive", "automation"):
        return False
    revision = record.get("revision")
    if isinstance(revision, bool) or not isinstance(revision, int) or revision < 1:
        return False
    if require_target:
        target = record.get("target")
        if not isinstance(target, dict):
            return False
        digest = target.get("digest")
        if not isinstance(digest, str) or not digest:
            return False
    return True

def _record_bound(record, state):
    """Field validity + revision binding: a record can never come from the future."""
    return (_record_valid(record)
            and record["revision"] <= _state_revision(state))

def _approval_valid(state):
    """Approval flag + record validity + the approved target still matches.

    The record stores the plan and mission digests at approval time; if
    either file changed afterwards the approval no longer covers what is
    being executed or shipped.
    """
    return (state.get("approved") is True
            and _record_bound(state.get("approval"), state)
            and _approval_target_matches(state))

def _ship_approval_valid(state):
    record = state.get("ship_approval")
    return (state.get("ship_approved") is True
            and _record_bound(record, state)
            and _record_valid(record, require_target=True))

# --- Ship target digest (BUG-03) ------------------------------------------

def _safe_sha(path):
    try:
        return hashlib.sha256(Path(path).read_bytes()).hexdigest()
    except OSError:
        return None

def _under_juicer(path):
    path = path.strip().strip('"')
    return path == ".juicer" or path.startswith(".juicer/")

def _porcelain_dirty_digest(root):
    """Digest of ``git status --porcelain`` with ``.juicer/`` artifacts removed.

    Juicer's own persistence (state.json, state.lock, atomic tmp) lives
    under ``.juicer/`` and must never flip the approval it just recorded.
    """
    try:
        proc = subprocess.run(["git", "-C", str(root), "status", "--porcelain"],
                              capture_output=True, text=True)
    except OSError:
        return None
    if proc.returncode != 0:
        return None
    kept = []
    for line in proc.stdout.splitlines():
        if len(line) < 4:
            kept.append(line)
            continue
        paths = [part.strip() for part in line[3:].split(" -> ")]
        if all(_under_juicer(part) for part in paths):
            continue
        kept.append(line)
    return hashlib.sha256("\n".join(kept).encode("utf-8")).hexdigest()

def ship_target_digest(state):
    """Digest of the approved target: plan, mission content, active unit and code.

    Everything under ``.juicer/`` is excluded from the git-dirty component
    (plan/mission enter via their content hashes instead), so state
    persistence can never invalidate an approval by itself.
    """
    parts = {
        "plan": _safe_sha(ROOT / ".juicer" / "plan.md"),
        "mission": _safe_sha(ROOT / ".juicer" / "mission.md"),
        "current_unit": state.get("current_unit"),
    }
    if (ROOT / ".git").exists():
        head = None
        try:
            proc = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "HEAD"],
                                  capture_output=True, text=True)
            if proc.returncode == 0:
                head = proc.stdout.strip() or None
        except OSError:
            head = None
        parts["git_head"] = head
        parts["git_dirty"] = _porcelain_dirty_digest(ROOT)
    payload = json.dumps(parts, sort_keys=True)
    return {"parts": parts, "digest": hashlib.sha256(payload.encode("utf-8")).hexdigest()}

def _approval_target(state):
    """The object that was approved: plan content + mission content + id."""
    parts = {"plan": _safe_sha(ROOT / ".juicer" / "plan.md"),
             "mission": _safe_sha(ROOT / ".juicer" / "mission.md"),
             "mission_id": state.get("mission_id")}
    payload = json.dumps(parts, sort_keys=True)
    return {"parts": parts,
            "digest": hashlib.sha256(payload.encode("utf-8")).hexdigest()}

def _approval_target_matches(state):
    record = state.get("approval")
    if not _record_valid(record, require_target=True):
        return False
    recorded = record["target"].get("parts")
    current = _approval_target(state)["parts"]
    return (isinstance(recorded, dict)
            and recorded.get("plan") == current["plan"]
            and recorded.get("mission") == current["mission"]
            and recorded.get("mission_id") == current["mission_id"])

def _refresh_ship_approval(state):
    """Eager invalidation inside update_state: ship binds to the exact target."""
    record = state.get("ship_approval")
    if not _record_valid(record, require_target=True):
        state["ship_approved"] = False
        return
    if record["target"]["digest"] != ship_target_digest(state)["digest"]:
        state["ship_approved"] = False

def _effective_state(state):
    """Computed status view: flags are only reported when fully backed."""
    notes = []
    if state.get("approved"):
        record = state.get("approval")
        if not _record_bound(record, state):
            state["approved"] = False
            notes.append("approved flag ignored: approval record missing or invalid "
                         "(re-run juicer approve)")
        elif not _approval_target_matches(state):
            state["approved"] = False
            notes.append("approved invalidated: plan or mission changed after "
                         "approval (re-run juicer approve)")
    if state.get("ship_approved"):
        record = state.get("ship_approval")
        if not (_record_bound(record, state)
                and _record_valid(record, require_target=True)):
            state["ship_approved"] = False
            notes.append("ship_approved flag ignored: ship approval record missing "
                         "or invalid (re-run juicer ship-approve)")
        elif record["target"]["digest"] != ship_target_digest(state)["digest"]:
            state["ship_approved"] = False
            notes.append("ship_approved invalidated: approved target changed "
                         "(plan/mission/unit/code)")
    return state, notes

def copy_missing(src, dst):
    if src.is_dir():
        for child in sorted(src.iterdir()):
            copy_missing(child, dst / child.name)
    elif src.is_file() and not dst.exists():
        confine_write(dst, what="init destination")
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dst)

# --- State machine ---------------------------------------------------------
# Every gate command validates its source state before transitioning.
# See docs/architecture.md §3 for the diagram.

MISSION_FROM = ("idle", "planning", "ready", "blocked", "done")
# `done` is included so a plan edited after `finish` can be re-approved
# before ship-approve; `executing` is not, because checkpointing to
# `ready` is always available from there.
APPROVE_FROM = ("planning", "blocked", "ready", "done")
START_FROM = ("ready", "blocked")
CHECKPOINT_RULES = {
    "executing": ("executing", "blocked"),
    "blocked": ("executing", "blocked"),
    "ready": ("executing", "blocked", "ready"),
    "done": ("ready",),
}
FINISH_FROM = ("ready", "done")
SHIP_FROM = ("ready", "done")

def require_state(action, status, allowed):
    if status not in allowed:
        fail(f"Cannot {action} from status={status} (allowed: {', '.join(allowed)})")

def available_commands(status):
    commands = []
    if status in MISSION_FROM:
        commands.append("mission")
    if status in APPROVE_FROM:
        commands.append("approve")
    if status in START_FROM:
        commands.append("start <unit>")
    if any(status in sources for sources in CHECKPOINT_RULES.values()):
        commands.append("checkpoint <status>")
    if status in FINISH_FROM:
        commands.append("finish")
    if status in SHIP_FROM:
        commands.append("ship-approve")
    return commands


def ensure_project_gitignore():
    """Track harness *configuration*, ignore only what Juicer generates.

    Blanket directory ignores (``.opencode/``, ``.claude/``, ...) would
    silently untrack settings files the user owns, so the managed block
    lists the exact generated paths instead. The block is rewritten in
    place when the pattern list changes; lines outside it are never
    touched.
    """
    path = ROOT / ".gitignore"
    confine_write(path, what="gitignore")
    lines = path.read_text().splitlines() if path.exists() else []
    marker = next((i for i, line in enumerate(lines)
                   if line.strip() == GITIGNORE_MARKER), None)
    if marker is None:
        head, tail = list(lines), []
    else:
        end = marker + 1
        while end < len(lines) and lines[end].strip():
            end += 1
        if lines[marker + 1:end] == list(PROJECT_MIRRORS):
            return
        head, tail = lines[:marker], lines[end:]
    while head and not head[-1].strip():
        head.pop()
    if head:
        head.append("")
    head.append(GITIGNORE_MARKER)
    head.extend(PROJECT_MIRRORS)
    path.write_text("\n".join(head + tail) + ("\n" if head + tail else ""))

def make_ctx(**options):
    return Ctx(root=ROOT, kit=KIT, state_dir=".juicer",
               skills_source=".agents/skills", agents_source="agents",
               options=dict(options))

def _import_adapter(directory, scope):
    own = str(directory)
    for path in (str(KIT / "adapters"), own):
        if path not in sys.path:
            sys.path.insert(0, path)
    safe = re.sub(r"[^a-zA-Z0-9_]", "_", directory.name)
    module_name = f"juicer_adapter_{scope}_{safe}"
    spec = importlib.util.spec_from_file_location(module_name, str(directory / "adapter.py"))
    module = importlib.util.module_from_spec(spec)
    sys.modules[module_name] = module
    spec.loader.exec_module(module)
    factory = getattr(module, "Adapter", None)
    if factory is None:
        fail(f"Adapter module has no Adapter class: {directory / 'adapter.py'}")
    adapter = factory() if isinstance(factory, type) else factory
    adapter_id = getattr(adapter, "id", None)
    if not isinstance(adapter_id, str) or not WORKER_NAME.match(adapter_id):
        fail(f"Adapter {directory / 'adapter.py'} has invalid id: {adapter_id!r} (expected ^[a-z][a-z0-9-]*$)")
    missing = [name for name in ("capabilities", "discover", "sync", "install", "invoke")
               if not callable(getattr(adapter, name, None))]
    if missing:
        fail(f"Adapter '{adapter_id}' missing methods: {', '.join(missing)}")
    return adapter

TRUST_PROJECT = False

def _env_trust():
    return os.environ.get("JUICER_TRUST_PROJECT_ADAPTERS", "").strip().lower() in ("1", "true", "yes", "on")

def project_adapters_trusted():
    return TRUST_PROJECT or _env_trust()

def _project_adapter_dirs():
    base = ROOT / "adapters"
    if not base.is_dir():
        return []
    return [entry for entry in sorted(base.iterdir())
            if entry.is_dir() and (entry / "adapter.py").exists()]

def load_adapters():
    """Discover adapters in KIT/adapters; ROOT/adapters only when trusted."""
    found = {}
    seen_paths = set()
    skipped = []
    trusted = project_adapters_trusted()
    for scope, base in (("kit", KIT / "adapters"), ("project", ROOT / "adapters")):
        if not base.is_dir():
            continue
        for entry in sorted(base.iterdir()):
            if not (entry.is_dir() and (entry / "adapter.py").exists()):
                continue
            resolved = entry.resolve()
            if resolved in seen_paths:
                continue
            if scope == "project" and not trusted:
                skipped.append(entry.name)
                continue
            adapter = _import_adapter(entry, scope)
            seen_paths.add(resolved)
            found[adapter.id] = adapter
    if skipped:
        names = ", ".join(f"adapters/{name}/" for name in skipped)
        print(f"warning: project adapters skipped (untrusted): {names} — "
              "pass --trust-project-adapters or set JUICER_TRUST_PROJECT_ADAPTERS=1",
              file=sys.stderr)
    return found

def _fail_unknown_adapter(target, adapters):
    if not project_adapters_trusted():
        candidate = ROOT / "adapters" / target
        if candidate.is_dir() and (candidate / "adapter.py").exists():
            fail(f"Adapter {target!r} comes from untrusted project code (adapters/{target}/); "
                 "pass --trust-project-adapters or set JUICER_TRUST_PROJECT_ADAPTERS=1")
    fail(f"Unknown adapter: {target} (available: {', '.join(sorted(adapters)) or 'none'})")

def get_adapter(target):
    adapters = load_adapters()
    if target in adapters:
        return adapters[target]
    _fail_unknown_adapter(target, adapters)

def list_adapters():
    return sorted(load_adapters())

def _format(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    if value is None:
        return "null"
    return str(value)

def show_capabilities(target):
    adapter = get_adapter(target)
    caps = adapter.capabilities()
    if not isinstance(caps, dict):
        fail(f"Adapter '{adapter.id}' capabilities() must return a dict")
    info = adapter.discover(make_ctx())
    print(f"id: {adapter.id}")
    print("capabilities (declared):")
    for key, value in caps.items():
        print(f"  {key}: {_format(value)}")
    print("discover:")
    for key in ("available", "version", "major", "notes"):
        if key in info:
            print(f"  {key}: {_format(info[key])}")

def _rel(path):
    try:
        return path.relative_to(ROOT).as_posix()
    except ValueError:
        return str(path)

def manifest_path(adapter_id):
    return ROOT / ".juicer" / "runtime" / "manifests" / f"{adapter_id}.json"

def load_manifest(adapter_id):
    path = manifest_path(adapter_id)
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text())
    except ValueError:
        return {}
    return data.get("files", {}) if isinstance(data, dict) else {}

def save_manifest(adapter_id, files):
    if files == load_manifest(adapter_id):
        return
    path = manifest_path(adapter_id)
    confine_write(path, what="manifest file")
    path.parent.mkdir(parents=True, exist_ok=True)
    payload = {"schema": 1, "adapter": adapter_id, "updated_at": now(),
               "files": dict(sorted(files.items()))}
    path.write_text(json.dumps(payload, indent=2) + "\n")

def _prune_empty_dirs(path):
    parent = path.parent
    while parent != ROOT:
        if not _inside_root(parent):
            break
        try:
            parent.rmdir()
        except OSError:
            break
        parent = parent.parent

def _inside_root(path):
    """True when ``path`` resolves strictly inside ROOT (root itself excluded)."""
    try:
        confine_path(ROOT, path, what="directory prune target")
    except ValueError:
        return False
    return True

def _require_owned(adapter, rel, what="manifest entry"):
    """Reject entries the adapter does not own (H-04).

    Confinement proves the path is inside the root; ownership proves the
    file belongs to this adapter's output. Without it a planted manifest
    entry could delete user source, ``AGENTS.md`` or harness settings the
    adapter never generates. The same rule runs at write time inside
    ``write_generated()``, so nothing is created before it is rejected.
    """
    require_owned(adapter.id, rel, tuple(adapter.owned_paths()), what=what)

def _validate_manifest(adapter, manifest):
    """Two-pass safety (BUG-07): reject every unsafe entry BEFORE any FS op."""
    unsafe = []
    for rel in manifest:
        try:
            confine_manifest_entry(ROOT, rel, adapter.id)
            _require_owned(adapter, rel)
        except ValueError as error:
            unsafe.append(str(error))
    if unsafe:
        fail(f"adapter {adapter.id!r} manifest contains {len(unsafe)} unsafe "
             "entr" + ("y" if len(unsafe) == 1 else "ies")
             + " (aborting: no file will be deleted and no manifest entry "
             "recorded): " + "; ".join(unsafe))

def _validate_change_paths(adapter, changes):
    unsafe = []
    for change in changes:
        try:
            confine_generated(ROOT, change.path, what="generated change path")
            if change.manifest and change.digest:
                _require_owned(adapter, _rel(change.path), what="generated path")
        except ValueError as error:
            unsafe.append(str(error))
    if unsafe:
        fail(f"adapter {adapter.id!r} produced unsafe paths (nothing will be "
             "recorded in the manifest or deleted): " + "; ".join(unsafe))

def apply_manifest(adapter, changes, dry_run=False, check=False, force=False):
    """Reconcile generated files against the adapter's manifest.

    Safety rules: only files recorded in the manifest may be deleted; a
    recorded file the user modified is kept (unless ``force``) and
    reported as a conflict. Project-owned files (``manifest=False``,
    e.g. AGENTS.md) and unmanaged files are never touched. All manifest
    entries and change paths are validated for confinement *and*
    adapter ownership before anything is read, deleted or written.
    """
    changes = [c for c in changes if c is not None]
    _validate_change_paths(adapter, changes)
    current, writes = {}, []
    for change in changes:
        if change.action == "write":
            writes.append(change)
        if change.manifest and change.digest:
            current[_rel(change.path)] = change.digest
    manifest = load_manifest(adapter.id)
    _validate_manifest(adapter, manifest)
    deletes, conflicts = [], []
    for rel, digest in manifest.items():
        if rel in current:
            continue
        path = ROOT / rel
        if not path.exists():
            continue  # already gone; drop from the manifest
        if force or sha256_file(path) == digest:
            deletes.append(rel)
        else:
            conflicts.append(rel)
    if not (dry_run or check):
        for rel in deletes:
            (ROOT / rel).unlink()
            _prune_empty_dirs(ROOT / rel)
        new_manifest = dict(current)
        for rel in conflicts:
            new_manifest[rel] = manifest[rel]
        save_manifest(adapter.id, new_manifest)
    return {"writes": writes, "deletes": deletes, "conflicts": conflicts,
            "current": set(current)}

PERMISSION_KEYS = ("permission", "permissions", "tools", "readonly", "sandbox_mode")

def _read_text_safe(path):
    try:
        return Path(path).read_text()
    except (OSError, UnicodeDecodeError):
        return None

def _permission_lines(text):
    """Permission-bearing lines of a generated harness file.

    Generated mirrors are gitignored, so a change to a project's
    `agents/*.md` that alters what the harness will allow would be
    invisible in a pull request. `sync` snapshots these lines before it
    writes and warns when they move.
    """
    lines = text.splitlines()
    if lines and lines[0].strip() == "---":
        close = next((i for i in range(1, len(lines))
                      if lines[i].strip() == "---"), len(lines))
        region = lines[1:close]
    else:
        region = []
        for line in lines:
            if '"""' in line:
                break  # TOML multi-line value: the body is not config
            region.append(line)
    out, index = [], 0
    while index < len(region):
        bare = region[index].strip()
        head = bare.split(":", 1)[0].split("=", 1)[0].strip().strip("\"'")
        if bare and head in PERMISSION_KEYS:
            out.append(bare)
            index += 1
            while index < len(region) and (not region[index].strip()
                                           or region[index][0].isspace()):
                if region[index].strip():
                    out.append(region[index].strip())
                index += 1
            continue
        index += 1
    return out

def _permission_snapshot(paths):
    snapshot = {}
    for rel in paths:
        path = ROOT / rel
        if not path.is_file():
            continue
        text = _read_text_safe(path)
        if text is not None:
            snapshot[rel] = _permission_lines(text)
    return snapshot

def _sync_one(adapter, ctx, dry_run, check, force, verb="synced", install=False):
    manifest = load_manifest(adapter.id)
    _validate_manifest(adapter, manifest)
    pre, before = {}, {}
    if not (dry_run or check):
        pre = {rel: sha256_file(ROOT / rel)
               for rel in manifest if (ROOT / rel).exists()}
        before = _permission_snapshot(manifest)
    method = adapter.install if install else adapter.sync
    with ownership_scope(adapter):
        changes = _call(method, ctx, dry_run=dry_run or check)
    info = apply_manifest(adapter, changes, dry_run=dry_run, check=check, force=force)
    if not (dry_run or check):
        info["regenerated"] = [rel for rel in pre
                               if rel in info["current"]
                               and pre[rel] != manifest.get(rel)]
        after = _permission_snapshot(info["current"])
        info["permission_changes"] = [rel for rel in after
                                      if rel in before and after[rel] != before[rel]]
    return _report_sync(adapter.id, info, dry_run, check, force, verb=verb)

def _report_sync(adapter_id, info, dry_run, check, force, verb="synced"):
    writes, deletes, conflicts = info["writes"], info["deletes"], info["conflicts"]
    if dry_run or check:
        pending = len(writes) + len(deletes) + len(conflicts)
        label = "check" if check else "plan"
        if not pending:
            print(f"sync {label}: {adapter_id} (up to date)")
            return 0
        print(f"sync {label}: {adapter_id} ({pending} pending)")
        for change in writes:
            print(f"  write {_rel(change.path)}")
        for rel in deletes:
            print(f"  delete {rel} (stale)")
        for rel in conflicts:
            print(f"  keep {rel} (modified since generation; use --force to remove)")
        return pending
    print(f"{verb}: {adapter_id} ({len(writes)} written, {len(deletes)} stale removed)")
    for rel in info.get("regenerated", ()):
        print(f"regenerated user-modified file: {rel}", file=sys.stderr)
    for rel in info.get("permission_changes", ()):
        print(f"permission configuration changed: {rel} — review it before "
              "shipping; generated mirrors are gitignored", file=sys.stderr)
    for rel in conflicts:
        print(f"conflict: {rel} (modified since generation; use --force to remove)",
              file=sys.stderr)
    return 0

def sync(target, opencode_format=None, dry_run=False, check=False, force=False):
    ensure_runtime()
    adapters = load_adapters()
    if target == "all":
        selected = [adapters[key] for key in sorted(adapters)]
        if not selected:
            fail("No adapters discovered (expected adapters/<id>/adapter.py in the kit or project)")
    elif target in adapters:
        selected = [adapters[target]]
    else:
        _fail_unknown_adapter(target, adapters)
    ctx = make_ctx(**({"opencode_format": opencode_format} if opencode_format else {}))
    pending = 0
    for adapter in selected:
        pending += _sync_one(adapter, ctx, dry_run, check, force)
    if check and pending:
        sys.exit(1)

def _call(method, *args, **kwargs):
    try:
        return method(*args, **kwargs)
    except ValueError as error:
        fail(str(error))


def _new_mission_id():
    return datetime.now().strftime("%Y%m%d-%H%M%S-%f") + "-" + uuid.uuid4().hex[:8]

def render_mission(objective):
    """Deterministic full render of mission.md from the kit template.

    A new mission starts a clean context: Status and Objective are
    replaced and every other section (Constraints, Scope, Decisions, ...)
    returns to its pristine template state.
    """
    template = MISSION_TEMPLATE.read_text()
    if MISSION_MARKER not in template:
        fail(f"kit mission template is missing the {MISSION_MARKER!r} marker")
    if "## Objective" not in template:
        fail("kit mission template is missing the '## Objective' section")
    if not re.search(r"(?m)^\*\*Status:\*\*\s*\S", template):
        fail("kit mission template is missing its '**Status:**' line")
    head, marker, tail = template.partition(MISSION_MARKER)
    head = re.sub(r"(?m)^\*\*Status:\*\*.*$", "**Status:** planning", head, count=1)
    before_objective, _, _ = head.partition("## Objective")
    return (before_objective + "## Objective\n\n" + objective.rstrip() + "\n\n"
            + marker + tail)

def cmd_init(args):
    ancestor = find_project_root()
    cwd = Path.cwd().resolve()
    if ancestor is not None and ancestor != cwd:
        # cwd sits inside an existing workspace. Creating a second one
        # would split state and gates across two roots with no signal.
        if not getattr(args, "nested", False):
            fail(f"already inside an initialized Juicer project at {ancestor}\n"
                 f"  working directory: {Path.cwd()}\n"
                 "  a nested workspace would split state, gates and sync targets\n"
                 "  across two roots. run `juicer init` from the project root, or\n"
                 "  pass --nested to create a separate workspace here on purpose.")
    ensure_runtime()
    copy_missing(KIT / "AGENTS.md", ROOT / "AGENTS.md")
    copy_missing(MISSION_TEMPLATE, ROOT / ".juicer" / "mission.md")
    copy_missing(PLAN_TEMPLATE, ROOT / ".juicer" / "plan.md")
    for name in ("handoff", "decisions", "learnings"):
        copy_missing(KIT / ".juicer" / "templates" / f"{name}.md",
                     ROOT / ".juicer" / f"{name}.md")
    for tree in [".juicer/workflows", "agents", ".agents/skills"]:
        copy_missing(KIT / tree, ROOT / tree)
    ensure_project_gitignore()
    sync("all")
    print("Juicer Kit v2.4.0 initialized.")
    if ancestor is not None:
        print(f"note: nested workspace created inside {ancestor}; "
              "commands run here target this directory only.",
              file=sys.stderr)

def _approval_summary(state, valid, label, key):
    record = state.get(key)
    if not isinstance(record, dict) or not record:
        print(f"{label}: none", file=sys.stderr)
        return
    verdict = "valid" if valid else "invalid"
    line = (f"{label}: {verdict} by={record.get('by')} via={record.get('via')} "
            f"at={record.get('at')} revision={record.get('revision')}")
    binding = record.get("code_binding")
    if binding is not None:
        line += f" code_binding={binding}"
    print(line, file=sys.stderr)
    if binding in ("none", "failed"):
        print(f"warning: {label} has code binding {binding} — it is NOT bound to "
              "a specific commit and must not be read as an attestation of the "
              "code being released.", file=sys.stderr)

def cmd_status(_):
    # Read-only by design: status must never create mission.md or state.
    # Root discovery already proved .juicer/state.json exists.
    if not STATE.exists():
        fail(f"missing state file {STATE}; run `juicer init` first")
    s, notes = _effective_state(read_state())
    print(json.dumps(s, indent=2))
    for note in notes:
        print(f"note: {note}", file=sys.stderr)
    _approval_summary(s, _approval_valid(s), "plan approval", "approval")
    _approval_summary(s, _ship_approval_valid(s), "ship approval", "ship_approval")
    commands = available_commands(s.get("status", "idle"))
    if commands:
        print("\navailable: " + ", ".join(commands))
    if MISSION.exists():
        print("\n--- mission ---")
        print(_trusted_text(MISSION, "mission file")[:3000])

def cmd_mission(args):
    ensure_runtime()
    state = read_state()
    require_state("start a new mission", state.get("status"), MISSION_FROM)
    text = render_mission(args.objective)  # fail early on template problems
    def mut(s):
        require_state("start a new mission", s.get("status"), MISSION_FROM)
        # Written inside the same lock as the state it describes: a reader
        # that took the lock can never observe new state with an old
        # mission (or the reverse), and a refused mission write leaves the
        # state untouched.
        _atomic_write_text(MISSION, text)
        s.update({"status":"planning","mission_id":_new_mission_id(),
                  "current_unit":None,"approved":False,"ship_approved":False})
        s.pop("approval", None)
        s.pop("ship_approval", None)
    update_state(mut)
    print("Mission created. Planning gate is pending.")
    print("Next: update .juicer/plan.md, then run `juicer approve`.")

def cmd_approve(args):
    ensure_runtime()
    state = read_state()
    require_state("approve", state.get("status"), APPROVE_FROM)
    by, via = approval_identity(args.by)
    def mut(s):
        require_state("approve", s.get("status"), APPROVE_FROM)
        if s.get("status") in ("planning", "blocked"):
            s["status"] = "ready"
        s["approved"] = True
        s["approval"] = _new_record(s, by=by, via=via, target=_approval_target(s))
    update_state(mut)
    print("Mission plan approved. Implementation may proceed.")

def _approval_block_reason(state):
    """Why the plan approval cannot be used right now, or None if it can.

    Kept separate from ``_approval_valid`` so callers can report *which*
    part of the approval failed instead of a single opaque verdict.
    """
    if not state.get("approved"):
        return "the plan has not been approved"
    record = state.get("approval")
    if not _record_bound(record, state):
        return "the approval record is missing or invalid (audit .juicer/state.json)"
    if not _approval_target_matches(state):
        return "the plan or mission changed after approval"
    return None

def cmd_start(args):
    ensure_runtime()
    state = read_state()
    reason = _approval_block_reason(state)
    if reason:
        fail(f"Blocked: {reason}; run juicer approve first.")
    require_state("start", state.get("status"), START_FROM)
    def mut(s):
        blocked = _approval_block_reason(s)
        if blocked:
            fail(f"Blocked: {blocked}; run juicer approve first.")
        require_state("start", s.get("status"), START_FROM)
        s.update({"status":"executing","current_unit":args.unit})
    update_state(mut)
    print(f"Active unit: {args.unit}")

def cmd_checkpoint(args):
    ensure_runtime()
    state = read_state()
    require_state(f"checkpoint {args.status}", state.get("status"),
                  CHECKPOINT_RULES[args.status])
    def mut(s):
        require_state(f"checkpoint {args.status}", s.get("status"),
                      CHECKPOINT_RULES[args.status])
        s["status"] = args.status
        if args.status in ("ready", "done"):
            s["current_unit"] = None
    update_state(mut)
    print(f"Checkpoint saved: {args.status}")

def ship_code_binding(root):
    """How tightly ship-approve is bound to the code it approves.

    ``sha`` — inside a git work tree with a reachable HEAD; the target
    digest then covers the commit and the porcelain status. ``failed`` —
    git exists but the code state could not be captured (no HEAD yet,
    ``git status`` failing). ``none`` — not a git work tree at all.

    Approval is always recorded either way. The value only states how
    much the target digest can vouch for: outside git, ``ship-approve``
    is a recorded human decision, never a cryptographic attestation of
    the code being released.
    """
    if shutil.which("git") is None:
        return "failed"
    def run(*argv):
        try:
            return subprocess.run(["git", "-C", str(root), *argv],
                                  capture_output=True, text=True)
        except OSError:
            return None
    inside = run("rev-parse", "--is-inside-work-tree")
    if inside is None or inside.returncode != 0:
        return "none"
    if run("rev-parse", "--verify", "HEAD").returncode != 0:
        return "failed"
    status = run("status", "--porcelain")
    if status is None or status.returncode != 0:
        return "failed"
    return "sha"

def cmd_ship_approve(args):
    ensure_runtime()
    state = read_state()
    require_state("ship-approve", state.get("status"), SHIP_FROM)
    blocked = _approval_block_reason(state)
    if blocked:
        fail(f"Cannot ship-approve: {blocked}; run juicer approve first.")
    by, via = approval_identity(args.by)
    binding = ship_code_binding(ROOT)
    def mut(s):
        require_state("ship-approve", s.get("status"), SHIP_FROM)
        blocked = _approval_block_reason(s)
        if blocked:
            fail(f"Cannot ship-approve: {blocked}; run juicer approve first.")
        s["ship_approved"] = True
        s["ship_approval"] = _new_record(s, by=by, via=via, code_binding=binding,
                                         target=ship_target_digest(s))
    update_state(mut)
    print("Production-impacting actions are approved.")
    if binding != "sha":
        print(f"warning: ship approval code binding: {binding} — outside a clean "
              "git work tree the approval is NOT bound to a specific commit. It is "
              "a record of an explicit human decision, not a cryptographic "
              "attestation of the code being released.", file=sys.stderr)

def find_worker(name):
    if not WORKER_NAME.match(name):
        fail(f"Invalid worker name: {name!r} (expected ^[a-z][a-z0-9-]*$)")
    for base in (ROOT / "agents", KIT / "agents"):
        role = base / f"{name}.md"
        if role.exists():
            resolved = role.resolve()
            inside = False
            for allowed in (ROOT, KIT):
                try:
                    resolved.relative_to(Path(allowed).resolve())
                    inside = True
                    break
                except ValueError:
                    continue
            if not inside:
                fail(f"worker contract {role} resolves outside the project and "
                     f"the kit ({resolved}); refusing to read it")
            return role
    fail(f"Unknown worker: {name} (searched {ROOT / 'agents'} and {KIT / 'agents'})")

def cmd_worker(args):
    role = find_worker(args.worker)
    print(f"Worker contract: {role}")
    print(_trusted_text(role, "worker contract"))
    print("\nRead .juicer/mission.md, .juicer/plan.md and .juicer/handoff.md before execution.")
    print("This command intentionally does not call a model. The active harness executes the worker.")

def cmd_install(args):
    ensure_runtime()
    adapter = get_adapter(args.target)
    options = {"opencode_format": args.opencode_format} if args.opencode_format else {}
    ctx = make_ctx(**options)
    pending = _sync_one(adapter, ctx, args.dry_run, args.check, args.force,
                        verb="installed", install=True)
    if args.check and pending:
        sys.exit(1)

def cmd_invoke(args):
    ensure_runtime()
    find_worker(args.worker)
    adapter = get_adapter(args.target)
    print(adapter.invoke(make_ctx(), args.worker, unit=args.unit))


def cmd_finish(_):
    ensure_runtime()
    state = read_state()
    require_state("finish", state.get("status"), FINISH_FROM)
    def mut(s):
        require_state("finish", s.get("status"), FINISH_FROM)
        s.update({"status":"done","current_unit":None})
    update_state(mut)
    print("Mission marked done.")

# --- Workspace discovery (BUG-04) -----------------------------------------
# Gate/state commands require an initialized workspace (.juicer/state.json
# in this directory or above). Read-only commands fall back to the cwd.

WORKSPACE_REQUIRED = {"status", "mission", "approve", "ship-approve", "start",
                      "checkpoint", "finish", "sync", "install", "invoke"}

def find_project_root(start=None):
    current = Path(start or Path.cwd()).resolve()
    for candidate in (current, *current.parents):
        if (candidate / ".juicer" / "state.json").is_file():
            return candidate
    return None

def bind_root(path):
    global ROOT, STATE, MISSION, PLAN, HANDOFF
    ROOT = Path(path)
    STATE = ROOT / ".juicer" / "state.json"
    MISSION = ROOT / ".juicer" / "mission.md"
    PLAN = ROOT / ".juicer" / "plan.md"
    HANDOFF = ROOT / ".juicer" / "handoff.md"

def _bind_for_command(cmd):
    root = find_project_root()
    if cmd == "init":
        bind_root(Path.cwd())
        return
    if cmd in WORKSPACE_REQUIRED:
        if root is None:
            fail(f"not inside an initialized Juicer project (no .juicer/state.json "
                 f"found up from {Path.cwd()}); run `juicer init` first")
        bind_root(root)
        return
    bind_root(root if root is not None else Path.cwd())

def main():
    p = argparse.ArgumentParser(prog="juicer")
    sub = p.add_subparsers(dest="cmd", required=True)
    trust = argparse.ArgumentParser(add_help=False)
    trust.add_argument("--trust-project-adapters", action="store_true",
                       help="import adapter.py from the project's adapters/ directory (untrusted by default)")
    by_help = "record this approval under an automation identity (required without a TTY)"
    for name, fn in [("status",cmd_status),("finish",cmd_finish)]:
        sub.add_parser(name).set_defaults(fn=fn)
    ap = sub.add_parser("approve")
    ap.add_argument("--by", default=None, metavar="ID", help=by_help)
    ap.set_defaults(fn=cmd_approve)
    spa = sub.add_parser("ship-approve")
    spa.add_argument("--by", default=None, metavar="ID", help=by_help)
    spa.set_defaults(fn=cmd_ship_approve)
    init = sub.add_parser("init", parents=[trust])
    init.add_argument("--nested", action="store_true",
                      help="create a separate workspace inside an existing Juicer project")
    init.set_defaults(fn=cmd_init)
    m = sub.add_parser("mission"); m.add_argument("objective"); m.set_defaults(fn=cmd_mission)
    st = sub.add_parser("start"); st.add_argument("unit"); st.set_defaults(fn=cmd_start)
    cp = sub.add_parser("checkpoint"); cp.add_argument("status", choices=["executing","blocked","ready","done"]); cp.set_defaults(fn=cmd_checkpoint)
    wk = sub.add_parser("worker"); wk.add_argument("worker"); wk.set_defaults(fn=cmd_worker)
    sy = sub.add_parser("sync", parents=[trust])
    sy.add_argument("target")
    sy.add_argument("--opencode-format", choices=["legacy", "v2"], default=None)
    sy.add_argument("--dry-run", action="store_true")
    sy.add_argument("--check", action="store_true")
    sy.add_argument("--force", action="store_true")
    sy.set_defaults(fn=lambda a: sync(a.target, opencode_format=a.opencode_format,
                                      dry_run=a.dry_run, check=a.check, force=a.force))
    ins = sub.add_parser("install", parents=[trust])
    ins.add_argument("target")
    ins.add_argument("--opencode-format", choices=["legacy", "v2"], default=None)
    ins.add_argument("--dry-run", action="store_true")
    ins.add_argument("--check", action="store_true")
    ins.add_argument("--force", action="store_true")
    ins.set_defaults(fn=cmd_install)
    inv = sub.add_parser("invoke", parents=[trust])
    inv.add_argument("target")
    inv.add_argument("worker")
    inv.add_argument("--unit", default=None)
    inv.set_defaults(fn=cmd_invoke)
    la = sub.add_parser("adapters", parents=[trust])
    la.set_defaults(fn=lambda a: print("\n".join(list_adapters())))
    ca = sub.add_parser("capabilities", parents=[trust])
    ca.add_argument("target")
    ca.set_defaults(fn=lambda a: show_capabilities(a.target))
    args = p.parse_args()
    global TRUST_PROJECT
    TRUST_PROJECT = bool(getattr(args, "trust_project_adapters", False))
    _bind_for_command(args.cmd)
    args.fn(args)

if __name__ == "__main__":
    main()
